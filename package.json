			"types": "./dist/modes/edge/index.d.ts",
			"import": "./dist/modes/edge/index.js"
		},
		"./host": {
			"types": "./dist/modes/host/index.d.ts",
			"import": "./dist/modes/host/index.js"
		}
	},
	"bin": {
		"troublemaker": "dist/main.js",
		"crawdad": "dist/main.js",
		"troublemaker-tui": "dist/tui.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
