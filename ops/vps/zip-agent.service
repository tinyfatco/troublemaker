[Unit]
Description=Zip Troublemaker agent
Requires=zip-workspace.service
After=zip-workspace.service network-online.target

[Service]
Type=simple
User=zip-agent
Group=zip-agent
WorkingDirectory=/opt/troublemaker
EnvironmentFile=/etc/zip-agent/agent.env
ExecStartPre=/usr/bin/install -d -m 0700 -o zip-agent -g zip-agent /srv/zip/workspace/.pi/agent
ExecStartPre=/bin/sh -c 'test ! -f /etc/zip-agent/codex-auth.json || /usr/bin/install -m 0600 /etc/zip-agent/codex-auth.json /srv/zip/workspace/.pi/agent/auth.json'
ExecStart=/usr/bin/node /opt/troublemaker/dist/main.js --sandbox=host --adapter=slack:socket,telegram:polling,email:webhook,mcp --port=3002 /srv/zip/workspace
Restart=on-failure
RestartSec=10
MemoryMax=320M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/srv/zip/workspace /srv/zip/r2-raw /srv/zip/cache
ProtectHome=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
