[Unit]
Description=Zip encrypted R2 backing mount
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=zip-agent
Group=zip-agent
ExecStart=/usr/bin/rclone mount zip-r2:fat-agents-data/agents/6884e994-60f4-4395-8008-38f73989c34d /srv/zip/r2-raw --config /etc/zip-agent/rclone.conf --vfs-cache-mode writes --vfs-cache-max-size 512M --cache-dir /srv/zip/cache --dir-cache-time 1m --poll-interval 30s
ExecStop=/bin/fusermount3 -u /srv/zip/r2-raw
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
