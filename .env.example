# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Slack adapter (optional — omit to disable)
# Socket mode (default): needs APP_TOKEN + BOT_TOKEN
# Webhook mode: needs BOT_TOKEN + SIGNING_SECRET
MOM_SLACK_APP_TOKEN=xapp-...
MOM_SLACK_BOT_TOKEN=xoxb-...
MOM_SLACK_SIGNING_SECRET=...

# Microsoft Teams adapter (optional — authenticated Bot Connector webhook)
MOM_TEAMS_CLIENT_ID=00000000-0000-0000-0000-000000000003
MOM_TEAMS_CLIENT_SECRET=...
MOM_TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000001
# Recommended production scope boundaries
MOM_TEAMS_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000001
MOM_TEAMS_ALLOWED_TEAMS=00000000-0000-0000-0000-000000000002
MOM_TEAMS_CHANNEL_MESSAGES_DIRECT=false

# Mattermost adapter (optional — outbound WebSocket + REST)
MOM_MATTERMOST_URL=https://mattermost.example.com
MOM_MATTERMOST_BOT_TOKEN=...
# Optional comma-separated Mattermost user IDs or usernames allowed to invoke by DM
MOM_MATTERMOST_ALLOWED_DM_USERS=operator-example
MOM_MATTERMOST_ALLOWED_CHANNELS=channel-id-example
MOM_MATTERMOST_CHANNEL_MESSAGES_DIRECT=false

# HTTP port for webhook adapters (default: 3000)
MOM_HTTP_PORT=3000

# Telegram adapter (optional — omit to disable)
# Polling mode (default): just needs BOT_TOKEN
# Webhook mode: needs BOT_TOKEN + WEBHOOK_URL + WEBHOOK_SECRET
MOM_TELEGRAM_BOT_TOKEN=...
MOM_TELEGRAM_WEBHOOK_URL=https://your-server:8443/telegram/webhook
MOM_TELEGRAM_WEBHOOK_SECRET=your-secret-token
MOM_TELEGRAM_WEBHOOK_PORT=8443
# Self-signed TLS cert for bare IP (omit if behind reverse proxy)
MOM_TELEGRAM_TLS_CERT=/path/to/webhook-cert.pem
MOM_TELEGRAM_TLS_KEY=/path/to/webhook-key.pem
