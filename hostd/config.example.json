{
  "company": {
    "id": "example-company",
    "actor": "front-desk"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 3099,
    "operatorTokenEnv": "TROUBLEMAKER_HOSTD_OPERATOR_TOKEN"
  },
  "state": {
    "database": "/var/lib/troublemaker-hostd/state.sqlite",
    "routingKeyFile": "/etc/troublemaker-hostd/routing.key"
  },
  "gmail": {
    "account": "agent@example.com",
    "gogPath": "/usr/local/bin/gog",
    "pollIntervalSeconds": 60,
    "overlapSeconds": 900
  },
  "mattermost": {
    "url": "http://127.0.0.1:18065",
    "runtimeUrl": "http://host.containers.internal:18065",
    "teamId": "aaaaaaaaaaaaaaaaaaaaaaaaaa",
    "batmanUserId": "bbbbbbbbbbbbbbbbbbbbbbbbbb",
    "adminTokenEnv": "MATTERMOST_HOSTD_ADMIN_TOKEN",
    "credentialsDirectory": "/var/lib/troublemaker-hostd/mattermost",
    "botDisplayName": "Manny"
  },
  "routing": {
    "actorTarget": "front-desk",
    "knownPrincipals": [
      {
        "email": "customer@example.com",
        "projects": [
          {
            "slug": "website",
            "name": "Company website"
          }
        ]
      }
    ]
  },
  "targets": [
    {
      "id": "front-desk",
      "driver": "oci",
      "protocol": "email-webhook",
      "engine": "podman",
      "image": "docker.io/library/node:22-bookworm",
      "checkout": "/opt/troublemaker",
      "skills": [
        "/opt/company-skills",
        "/opt/vendor-skills"
      ],
      "workspaceTemplate": "/var/lib/troublemaker-hostd/templates/front-desk",
      "contextsDirectory": "/var/lib/troublemaker-hostd/contexts",
      "basePort": 32000,
      "maxPort": 32999,
      "memory": "420m",
      "stopAfterTurn": false,
      "gmailToolsOnly": true,
      "hostGateway": "host.containers.internal",
      "inboundTokenEnv": "FRONT_DESK_RUNTIME_INBOUND_TOKEN",
      "outboundTokenEnv": "FRONT_DESK_RUNTIME_OUTBOUND_TOKEN",
      "runtimeEnv": {
        "MOM_MODEL": "openai-codex/gpt-5.6-sol",
        "MOM_THINKING": "high"
      }
    }
  ]
}
