{
  "company": {
    "id": "example-company",
    "actor": "front-desk"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 3099,
    "operatorTokenEnv": "TROUBLEMAKER_HOSTD_OPERATOR_TOKEN"
  },
  "webApp": {
    "host": "127.0.0.1",
    "port": 3120,
    "assertionSecretEnv": "TROUBLEMAKER_HOSTD_WEB_APP_SECRET",
    "issuer": "fat-platform",
    "audience": "troublemaker-hostd-web",
    "agentName": "Operator"
  },
  "state": {
    "database": "/var/lib/troublemaker-hostd/state.sqlite",
    "routingKeyFile": "/etc/troublemaker-hostd/routing.key"
  },
  "gmail": {
    "account": "agent@example.com",
    "internalDomains": [
      "internal.example.com"
    ],
    "gogPath": "/usr/local/bin/gog",
    "pollIntervalSeconds": 60,
    "overlapSeconds": 900,
    "contactRelays": [
      {
        "sender": "noreply@example.com",
        "signatureSecretEnv": "CONTACT_RELAY_SECRET",
        "project": {
          "slug": "website",
          "name": "Customer website"
        }
      }
    ],
    "alwaysTo": [
      "owner@example.com"
    ],
    "alwaysCc": [
      "archive@example.com"
    ]
  },
  "scheduler": {
    "maxConcurrent": 6,
    "leaseSeconds": 60,
    "turnLeaseSeconds": 900,
    "idleSeconds": 300,
    "tickSeconds": 2,
    "maximumAttempts": 5
  },
  "scheduledWakes": {
    "mode": "off",
    "contextIds": []
  },
  "openAi": {
    "apiKeyEnv": "OPENAI_ORGANIZATION_API_KEY",
    "scope": {
      "mode": "all",
      "contextIds": []
    },
    "monthlySpendCapCents": 2500,
    "maximumOutputTokens": 32768,
    "maximumConcurrentPerContext": 1,
    "maximumConcurrentGlobal": 6
  },
  "workersAi": {
    "accountId": "0123456789abcdef0123456789abcdef",
    "apiTokenEnv": "CLOUDFLARE_WORKERS_AI_API_TOKEN",
    "analyticsTokenEnv": "CLOUDFLARE_ACCOUNT_ANALYTICS_TOKEN",
    "analyticsPollSeconds": 900,
    "analyticsLookbackSeconds": 21600,
    "allowedModels": [
      "@cf/zai-org/glm-5.2"
    ],
    "limits": {
      "windowSeconds": 900,
      "maximumRequestsPerContext": 12,
      "maximumTokensPerContext": 1000000,
      "maximumRequestsGlobal": 60,
      "maximumTokensGlobal": 5000000,
      "maximumConcurrentPerContext": 1,
      "maximumConcurrentGlobal": 4
    }
  },
  "zulip": {
    "url": "http://127.0.0.1:3110",
    "administratorEmail": "operator@example.com",
    "administratorApiKeyEnv": "ZULIP_HOSTD_ADMIN_API_KEY",
    "agentEmail": "operator-bot@example.com",
    "agentApiKeyEnv": "ZULIP_HOSTD_AGENT_API_KEY",
    "projectorEmail": "projector-bot@example.com",
    "projectorApiKeyEnv": "ZULIP_HOSTD_PROJECTOR_API_KEY",
    "memberEmails": [
      "operator@example.com"
    ],
    "observerEmails": [
      "observer-bot@example.com"
    ],
    "agentDisplayName": "Operator",
    "projectorDisplayName": "TINYFAT"
  },
  "phone": {
    "provider": "sendly",
    "senderAddress": "+15555550100",
    "webhookSecretEnv": "PHONE_WEBHOOK_SECRET",
    "apiKeyEnv": "PHONE_API_KEY",
    "directOnly": true,
    "ingress": {
      "host": "127.0.0.1",
      "port": 3100,
      "path": "/webhooks/sendly"
    }
  },
  "webChat": {
    "relay": {
      "url": "https://example.com/api/internal/landing-chat",
      "tokenEnv": "LANDING_CHAT_RELAY_TOKEN",
      "encryptionKeyEnv": "LANDING_CHAT_RELAY_ENCRYPTION_KEY",
      "pollIntervalSeconds": 1
    }
  },
  "routing": {
    "actorTarget": "front-desk",
    "knownPrincipals": [
      {
        "email": "customer@example.com",
        "name": "Example Customer",
        "projects": []
      }
    ],
    "knownPhonePrincipals": [
      {
        "phone": "+15555550123",
        "name": "Example Owner",
        "model": {
          "provider": "cloudflare-workers-ai",
          "id": "@cf/zai-org/glm-5.2"
        }
      }
    ]
  },
  "targets": [
    {
      "id": "front-desk",
      "driver": "oci",
      "protocol": "email-webhook",
      "engine": "/opt/troublemaker/hostd/bin/podman-user-session",
      "image": "localhost/troublemaker-runtime:git-commit",
      "immutableImage": true,
      "runtimeVersion": "git-commit",
      "checkout": "/opt/troublemaker",
      "skills": [
        "/opt/company-skills"
      ],
      "workspaceTemplate": "/var/lib/troublemaker-hostd/templates/front-desk",
      "contextsDirectory": "/var/lib/troublemaker-hostd/contexts",
      "basePort": 32000,
      "maxPort": 32999,
      "memory": "420m",
      "stopAfterTurn": false,
      "gmailToolsOnly": true,
      "hostGateway": "10.0.2.2",
      "inboundTokenEnv": "FRONT_DESK_RUNTIME_INBOUND_TOKEN",
      "outboundTokenEnv": "FRONT_DESK_RUNTIME_OUTBOUND_TOKEN"
    }
  ]
}
