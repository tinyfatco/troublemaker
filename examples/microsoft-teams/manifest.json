{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000003",
  "packageName": "com.example.troublemaker",
  "developer": {
    "name": "Example Operator",
    "websiteUrl": "https://bot.example.com",
    "privacyUrl": "https://bot.example.com/privacy",
    "termsOfUseUrl": "https://bot.example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Troublemaker",
    "full": "Troublemaker collaborative agent"
  },
  "description": {
    "short": "A collaborative agent for Microsoft Teams",
    "full": "A persistent collaborative agent with direct chats, group chats, channel threads, ambient awareness, reactions, files, and proactive delivery."
  },
  "accentColor": "#6264A7",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000003",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": true,
      "isNotificationOnly": false
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "webApplicationInfo": {
    "id": "00000000-0000-0000-0000-000000000003",
    "resource": "api://bot.example.com/00000000-0000-0000-0000-000000000003"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "ChannelMessage.Read.Group",
          "type": "Application"
        },
        {
          "name": "ChatMessage.Read.Chat",
          "type": "Application"
        }
      ]
    }
  },
  "validDomains": [
    "bot.example.com"
  ]
}
